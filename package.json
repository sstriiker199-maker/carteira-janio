{
  "name": "carteira-janio",
  "productName": "Wallet - Trabalho",
  "version": "0.5.0",
  "description": "Carteira de criptomoedas com várias carteiras",
  "author": "Janio",
  "license": "UNLICENSED",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sstriiker199-maker/carteira-janio.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "postinstall": "node scripts/copiar-icones.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ethers": "^6.13.0",
    "qrcode": "^1.5.4",
    "tronweb": "^6.0.0",
    "nodemailer": "^6.9.16",
    "bitcoinjs-lib": "6.1.7",
    "cashaddrjs": "^0.4.4",
    "@solana/web3.js": "^1.98.0",
    "@solana/spl-token": "^0.4.9",
    "xrpl": "^4.2.0",
    "@ton/ton": "^15.1.0",
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.3.0",
    "@emurgo/cardano-serialization-lib-nodejs": "^12.1.1",
    "@ston-fi/sdk": "^2.7.0",
    "@ston-fi/api": "^0.33.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "cryptocurrency-icons": "^0.18.1"
  },
  "build": {
    "appId": "com.janio.carteira",
    "productName": "Wallet - Trabalho",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Wallet-Trabalho-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Wallet - Trabalho"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sstriiker199-maker",
        "repo": "carteira-janio",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
