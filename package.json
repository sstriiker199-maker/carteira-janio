{
  "name": "carteira-janio",
  "productName": "Carteira Janio",
  "version": "0.1.0",
  "description": "Carteira de criptomoedas com várias carteiras (Etapa 1: Ethereum, BNB Chain, Polygon, Avalanche, Tron)",
  "author": "Janio",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ethers": "^6.13.0",
    "qrcode": "^1.5.4",
    "tronweb": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.janio.carteira",
    "productName": "Carteira Janio",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Carteira-Janio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Carteira Janio"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
